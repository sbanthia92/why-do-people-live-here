ANTHROPIC_API_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Wikimedia asks for a real contact (email or URL) here
WIKIMEDIA_USER_AGENT=whydopeoplelivehere/0.1 (contact@example.com)
DATABASE_URL=postgresql://user:password@localhost:5432/wdplh
# true = the closing reply links to the Wikipedia article. X charges far more for a post
# containing a link ($0.20 vs $0.015 at the time of writing), so by default the source
# is named in text instead.
SOURCE_LINK=false
# false = no map card on the first post. The card is drawn from public-domain map data.
MAP_CARDS=true
# true = where no map card can be drawn, attach the article's lead photo, only if it is on Wikimedia
# Commons as CC0 or public domain with no rights warnings. Off by default: see "Images" in the README.
POST_IMAGES=false
# true = generate and print the post, but do not publish to X
DRY_RUN=true
